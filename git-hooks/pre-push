#!/bin/sh
# pre-push: check that every JS file parses, and say exactly which line is wrong.
# One syntax error in any of these files breaks the whole live site (text.js included),
# and the check takes about a second, so it is safe to run on every push.
#
# Enable once, in this repository:
#   git config core.hooksPath git-hooks
# Turn it off with:
#   git config --unset core.hooksPath
#
# The level tests are NOT run here: they take ~3 minutes and text.js does not affect the levels.
# Run them yourself (node test.js) after changing engine.js or levels.js.

NODE=$(command -v node 2>/dev/null || true)
if [ -z "$NODE" ] && [ -x "/c/Users/imidazoliumeow/.dsh/dsh-runtimes/dsh-primary-runtime/dependencies/node/bin/node.exe" ]; then
    NODE="/c/Users/imidazoliumeow/.dsh/dsh-runtimes/dsh-primary-runtime/dependencies/node/bin/node.exe"
fi
if [ -z "$NODE" ]; then
    echo "pre-push: node not found, skipping the syntax check"
    exit 0
fi

fail=0
for f in engine.js levels.js text.js tetra3d.js notesview.js ui.js make-site.js; do
    [ -f "$f" ] || continue
    err=$("$NODE" --check "$f" 2>&1)
    if [ $? -ne 0 ]; then
        fail=1
        # node prints "<path>:<line>" as the first line, then the source line, then the message
        line=$(printf '%s\n' "$err" | tr -d '\r' | sed -n 's/^.*:\([0-9][0-9]*\)$/\1/p' | head -n 1)
        message=$(printf '%s\n' "$err" | tr -d '\r' | grep -m1 'SyntaxError' | sed 's/^[[:space:]]*//')
        echo ""
        if [ -n "$line" ]; then
            echo "pre-push: SYNTAX ERROR in $f at line $line"
            snippet=$(sed -n "${line}p" "$f" | tr -d '\r' | cut -c1-110)
            echo "    $line | $snippet"
        else
            echo "pre-push: SYNTAX ERROR in $f"
        fi
        [ -n "$message" ] && echo "    $message"
    fi
done

if [ "$fail" -ne 0 ]; then
    echo ""
    echo "pre-push: not pushing. Fix the line(s) above and push again."
    echo "          A raw line break inside a \"...\" string and an unescaped \" are the usual causes."
    exit 1
fi

echo "pre-push: all JS files parse"
